{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pixelpalacetauri",
  "version": "0.1.5",
  "identifier": "com.pixelpalace.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel Palace",
        "width": 1600,
        "height": 900,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
    ],
    "resources": [
      "openstarbound",
      "solarus",
      "tiled"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}